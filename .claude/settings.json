{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(find *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-remote *)",
      "Bash(git branch*)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(curl -s *)",
      "Bash(bundle exec jekyll *)",
      "Bash(stat *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-post-frontmatter.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/image-size-check.sh"
          }
        ]
      }
    ]
  }
}
